generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication & Users
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  dailyChecks    DailyCheck[]
  orders         Order[]
  notifications  Notification[]
  passwordResetTokens PasswordResetToken[]
  emailPreferences EmailPreferences?

  @@map("users")
}

model EmailPreferences {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // General preferences
  enableEmailNotifications Boolean @default(true)
  
  // Notification type preferences
  lowStockAlerts      Boolean @default(true)
  maintenanceAlerts   Boolean @default(true)
  orderNotifications  Boolean @default(true)
  medicationAlerts    Boolean @default(true)
  emergencyAlerts     Boolean @default(true)
  systemNotifications Boolean @default(false)
  
  // Priority level preferences
  urgentOnly          Boolean @default(false)
  highPriorityOnly    Boolean @default(false)
  
  // Delivery preferences
  digestMode          Boolean @default(false)
  digestFrequency     DigestFrequency @default(DAILY)

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@map("email_preferences")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("password_reset_tokens")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  email       String?
  timezone    String   @default("UTC")
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users           User[]
  vehicles        Vehicle[]
  inventoryItems  InventoryItem[]
  locations       Location[]
  orders          Order[]
  suppliers       Supplier[]
  dailyCheckItems DailyCheckItem[]

  @@map("organizations")
}

// Fleet Management
model Vehicle {
  id           String        @id @default(cuid())
  unitNumber   String        @unique
  make         String
  model        String
  year         Int
  vin          String        @unique
  licensePlate String        @unique
  mileage      Int           @default(0)
  status       VehicleStatus @default(IN_SERVICE)
  fuelLevel    Float         @default(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  dailyChecks    DailyCheck[]
  maintenanceRecords MaintenanceRecord[]
  documents      VehicleDocument[]
  medications    Medication[]

  @@map("vehicles")
}

model MaintenanceRecord {
  id          String            @id @default(cuid())
  type        MaintenanceType
  description String
  cost        Float?
  mileage     Int
  serviceDate DateTime
  nextDue     DateTime?
  provider    String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  @@map("maintenance_records")
}

model VehicleDocument {
  id           String      @id @default(cuid())
  type         DocumentType
  name         String
  issueDate    DateTime
  expiryDate   DateTime?
  documentUrl  String?
  provider     String?
  policyNumber String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  @@map("vehicle_documents")
}

// Daily Checks
model DailyCheck {
  id           String           @id @default(cuid())
  date         DateTime         @default(now())
  shift        String
  mileage      Int
  fuelLevel    Float
  status       DailyCheckStatus @default(PENDING)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  items     DailyCheckItemResult[]

  @@map("daily_checks")
}

model DailyCheckItem {
  id          String   @id @default(cuid())
  category    String
  name        String
  description String?
  isRequired  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  results        DailyCheckItemResult[]

  @@map("daily_check_items")
}

model DailyCheckItemResult {
  id       String              @id @default(cuid())
  status   DailyCheckItemStatus
  notes    String?
  createdAt DateTime           @default(now())

  // Relations
  dailyCheck     DailyCheck     @relation(fields: [dailyCheckId], references: [id], onDelete: Cascade)
  dailyCheckId   String
  checkItem      DailyCheckItem @relation(fields: [checkItemId], references: [id])
  checkItemId    String

  @@map("daily_check_item_results")
}

// Inventory Management
model Location {
  id          String       @id @default(cuid())
  name        String
  type        LocationType
  description String?
  capacity    Int?
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  parent         Location?       @relation("LocationHierarchy", fields: [parentId], references: [id])
  children       Location[]      @relation("LocationHierarchy")
  inventoryItems InventoryItem[]

  @@map("locations")
}

model InventoryItem {
  id          String            @id @default(cuid())
  name        String
  description String?
  category    InventoryCategory
  sku         String?           @unique
  currentStock Int              @default(0)
  minStock    Int               @default(0)
  maxStock    Int?
  unitCost    Float?
  unitPrice   Float?
  expiryDate  DateTime?
  lotNumber   String?
  supplier    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  location       Location?    @relation(fields: [locationId], references: [id])
  locationId     String?
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@map("inventory_items")
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  quantity    Int
  reason      String?
  reference   String?
  createdAt   DateTime          @default(now())

  // Relations
  item   InventoryItem @relation(fields: [itemId], references: [id])
  itemId String

  @@map("stock_movements")
}

// Medications
model Medication {
  id             String   @id @default(cuid())
  name           String
  dosage         String
  form           String   // tablet, injection, liquid, etc.
  lotNumber      String
  expiryDate     DateTime
  quantity       Int
  isControlled   Boolean  @default(false)
  controlledClass String?
  location       MedicationLocation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  @@map("medications")
}

// Orders & Suppliers
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  orders         Order[]

  @@map("suppliers")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)
  priority    OrderPriority @default(NORMAL)
  totalAmount Float       @default(0)
  notes       String?
  orderDate   DateTime    @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  supplierId     String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  items          OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  receivedQty  Int     @default(0)
  createdAt    DateTime @default(now())

  // Relations
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  item    InventoryItem @relation(fields: [itemId], references: [id])
  itemId  String

  @@map("order_items")
}

// Notifications
model Notification {
  id        String             @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  isRead    Boolean            @default(false)
  data      Json?
  createdAt DateTime           @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("notifications")
}

// Enums
enum UserRole {
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum VehicleStatus {
  IN_SERVICE
  OUT_OF_SERVICE
  MAINTENANCE
  REPAIR_SHOP
  RETIRED
}

enum MaintenanceType {
  OIL_CHANGE
  INSPECTION
  REPAIR
  PREVENTIVE
  EMERGENCY
  TIRE_ROTATION
  BRAKE_SERVICE
  TRANSMISSION
  ENGINE
  ELECTRICAL
  OTHER
}

enum DocumentType {
  REGISTRATION
  INSURANCE
  INSPECTION
  LICENSE
  PERMIT
  WARRANTY
  OTHER
}

enum DailyCheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DailyCheckItemStatus {
  PASS
  FAIL
  NA
}

enum LocationType {
  BUILDING
  ROOM
  CABINET
  SHELF
  CONTAINER
  VEHICLE
  OTHER
}

enum InventoryCategory {
  EMERGENCY
  CONSUMABLES
  EQUIPMENT
  MEDICATIONS
  SUPPLIES
  TOOLS
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  EXPIRED
  DAMAGED
}

enum MedicationLocation {
  MAIN_SUPPLY
  VEHICLE
}

enum OrderStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DigestFrequency {
  DAILY
  WEEKLY
  NEVER
}
